# Node Environment
NODE_ENV=development

# Temporal Configuration
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=cellweave-orchestrator-queue

# Optional mTLS Configuration (for Temporal Cloud in staging/production)
TEMPORAL_CLIENT_CERT_PATH=
TEMPORAL_CLIENT_KEY_PATH=

# Modal Compute Provider Configuration
MODAL_API_URL=
MODAL_APP_NAME=cellweave-science

# Logging
LOG_LEVEL=info
